# Copy to .env:  cp .env.example .env     (.env is git-ignored; never commit it)
# Docker Compose reads this file for both the postgres and backend containers.
# In production these names are set in the Render dashboard instead (see README).

# development | test | production
APP_ENV=development
# Local only. Render sets PORT itself.
API_PORT=8080

# Database container. Local development only.
POSTGRES_USER=zuscar
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=zuscar

# The API connects with this. The host is the Compose service name "postgres" because the API runs in Docker.
# Keep the user, password and database name identical to the three lines above.
# Production: the Supabase connection string, pasted into Render (never into a file).
DATABASE_URL=postgres://zuscar:change-me-dev-only@postgres:5432/zuscar?sslmode=disable
# Set true only behind a transaction-mode pooler (no prepared statements).
DB_SIMPLE_PROTOCOL=false

# The web app's public address. Must equal the browser's origin exactly: it is used for the CSRF origin check.
# Local: http://localhost:3000    Production: your https Vercel or custom-domain URL
FRONTEND_URL=http://localhost:3000
# Must be true in production (the API refuses to start otherwise). false only for plain-http localhost.
COOKIE_SECURE=false

LOG_LEVEL=info
SESSION_IDLE_TTL=2h
SESSION_ABSOLUTE_TTL=12h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW=15m
IDEMPOTENCY_TTL=24h
MAX_REQUEST_BYTES=1048576
